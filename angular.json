{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "TestPanel2": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": false
        },
        "@schematics/angular:directive": {
          "standalone": false
        },
        "@schematics/angular:pipe": {
          "standalone": false
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": [
              "src/assets/css/style.css",
              "src/assets/css/vendors/bootstrap.css",
              "src/assets/css/vendors/feather-icon.css",
              "src/assets/css/color-1.css",
              "src/assets/css/responsive.css"
            ],

            "scripts": [
               "src/assets/js/jquery.min.js",
               "src/assets/js/bootstrap/bootstrap.bundle.min.js",
               "src/assets/js/icons/feather-icon/feather.min.js",
               "src/assets/js/icons/feather-icon/feather-icon.js",
               "src/assets/js/scrollbar/simplebar.js",
               "src/assets/js/scrollbar/custom.js",
               "src/assets/js/config.js",
               "src/assets/js/sidebar-menu.js",
               "src/assets/js/sidebar-pin.js",
               "src/assets/js/clock.js",
               "src/assets/js/slick/slick.min.js",
               "src/assets/js/slick/slick.js",
               "src/assets/js/header-slick.js",
               "src/assets/js/chart/apex-chart/apex-chart.js",
               "src/assets/js/chart/apex-chart/stock-prices.js",
               "src/assets/js/chart/apex-chart/moment.min.js",
               "src/assets/js/notify/bootstrap-notify.min.js",
               "src/assets/js/dashboard/default.js",
               "src/assets/js/notify/index.js",
               "src/assets/js/typeahead/handlebars.js",
               "src/assets/js/typeahead/typeahead.bundle.js",
               "src/assets/js/typeahead/typeahead.custom.js",
               "src/assets/js/typeahead-search/handlebars.js",
               "src/assets/js/typeahead-search/typeahead-custom.js",
               "src/assets/js/height-equal.js",
               "src/assets/js/animation/wow/wow.min.js",
               "src/assets/js/script.js",
               "src/assets/js/theme-customizer/customizer.js"
            ]

          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "TestPanel2:build:production"
            },
            "development": {
              "buildTarget": "TestPanel2:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": [
              "src/styles.scss",
              "src/assets/css/style.css",
              "src/assets/styles.css",
              "src/assets/css/vendors/bootstrap.css",
              "src/assets/css/vendors/feather-icon.css",
              "src/assets/css/color-1.css",
              "src/assets/css/responsive.css"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
